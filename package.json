{
  "name": "rovarin-dashboard",
  "version": "0.2.2",
  "description": "Lightweight personal Rovarining dashboard for Windows accessible via Tailscale",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev-watcher.js",
    "build:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packaging/build.ps1",
    "release:verify": "node scripts/release-verify.js",
    "test:packaging": "node scripts/packaging-smoke-test.js",
    "test:security": "node scripts/security-smoke-test.js",
    "test:maintenance": "node scripts/maintenance-smoke-test.js",
    "test:temperature": "node scripts/temperature-manager-smoke-test.js",
    "test:gpu": "node scripts/gpu-degradation-smoke-test.js",
    "test:processes": "node scripts/process-stats-smoke-test.js",
    "test:kill": "node scripts/process-kill-smoke-test.js && node scripts/process-tree-smoke-test.js",
    "test:dev-watcher": "node scripts/dev-watcher-smoke-test.js",
    "test:apps": "node scripts/app-manager-smoke-test.js",
    "test:system-ui": "node scripts/system-management-ui-smoke-test.js",
    "test:process-labels": "node scripts/process-display-smoke-test.js"
  },
  "keywords": [
    "system-monitor",
    "dashboard",
    "tailscale",
    "windows",
    "hardware"
  ],
  "license": "PolyForm-Noncommercial-1.0.0"
}
